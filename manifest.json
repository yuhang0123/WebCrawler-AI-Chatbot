{
    "manifest_version": 3,
    "name": "Webcrawler AI Chatbot",
    "version": "1.0",
    "description": "Ask questions about the webpage you are currently viewing.",
    "permissions": [
      "scripting",
      "storage",
      "sidePanel"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Open WebCrawler AI Chatbot",
      "default_icon": {
        "16": "images/logo.png",
        "48": "images/logo.png",
        "128": "images/logo.png"
      }
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "icons": {
      "16": "images/logo.png",
      "48": "images/logo.png",
      "128": "images/logo.png"
    }
}